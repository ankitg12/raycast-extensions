{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "omarchy-macos-keybindings",
  "title": "Omarchy Keybindings",
  "description": "Omarchy-style searchable keybinding menu (Super+K equivalent) for AeroSpace on macOS",
  "icon": "command-icon.png",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Show Keybindings",
      "description": "Fuzzy-searchable AeroSpace keybindings from live config",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.102.0",
    "@raycast/utils": "^1.17.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "eslint": "^8.57.1",
    "prettier": "^3.9.10",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
